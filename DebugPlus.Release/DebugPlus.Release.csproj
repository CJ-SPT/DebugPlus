<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <PackageDebugPlus Condition="'$(PackageDebugPlus)' == ''">true</PackageDebugPlus>
  </PropertyGroup>
  <!-- Build-only dependencies ensure packaging waits for every component in CLI and IDE builds. -->
  <ItemGroup>
    <ProjectReference Include="../DebugPlus/DebugPlus.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../DebugPlus.Fika/DebugPlus.Fika.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../DebugPlus.Server/DebugPlus.Server.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="PackageDebugPlusRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(PackageDebugPlus)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../tools/Build.ps1&quot; -Action Package -SkipBuild -GameRoot &quot;$(TarkovDir).&quot;" />
  </Target>
</Project>
