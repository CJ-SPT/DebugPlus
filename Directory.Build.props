<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)DebugPlus/VERSION.txt').Trim())</Version>
    <TarkovDir Condition="'$(TarkovDir)' == ''">$(MSBuildThisFileDirectory)..\..\</TarkovDir>
    <ManagedDir>$(TarkovDir)EscapeFromTarkov_Data\Managed\</ManagedDir>
    <BepInExDir>$(TarkovDir)BepInEx\</BepInExDir>
    <!-- HarmonyX 2.16.0 is the first release with .NET 10 support. -->
    <HarmonyXVersion>2.16.0</HarmonyXVersion>
    <DeployDebugPlus Condition="'$(DeployDebugPlus)' == ''">false</DeployDebugPlus>
  </PropertyGroup>
</Project>
