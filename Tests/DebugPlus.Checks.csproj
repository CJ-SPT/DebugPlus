<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../DebugPlus.Common/DebugPlus.Common.csproj" /></ItemGroup>
  <ItemGroup><Compile Remove="NativeCapture/**/*.cs" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../DebugPlus/Logging/LogStore.cs" Link="Logging/LogStore.cs" />
    <Compile Include="../DebugPlus/Logging/NativeCapture.cs" Link="Logging/NativeCapture.cs" />
    <Compile Include="../DebugPlus/Logging/GateOverride.cs" Link="Logging/GateOverride.cs" />
    <Compile Include="../DebugPlus/Logging/LogSource.cs" Link="Logging/LogSource.cs" />
    <Reference Include="NLog" HintPath="$(ManagedDir)NLog.dll" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)core/BepInEx.dll" />
  </ItemGroup>
</Project>
